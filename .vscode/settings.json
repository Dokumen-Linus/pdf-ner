{
  // all
  "editor.bracketPairColorization.enabled": true,
  "editor.formatOnPaste": true,
  "editor.formatOnSave": true,
  "editor.guides.bracketPairs": "active",
  "editor.insertSpaces": true,
  "files.autoSave": "onFocusChange",
  "git.branchProtection": ["master"],
  "git.confirmNoVerifyCommit": true,
  "git.enableSmartCommit": true,
  "git.fetchOnPull": true,

  // use Kilo Code for autocomplete instead of GitHub Copilot
  "github.copilot.enable": {
    "*": false
  },
  "editor.inlineSuggest.enabled": true,
  "editor.quickSuggestions": {
    "other": "inline",
    "comments": "off",
    "strings": "off"
  },

  // python
  "python.analysis.typeCheckingMode": "strict",
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit",
      "source.fixAll.ruff": "explicit"
    }
  },
  "ruff.configuration": "pyproject.toml",
  "ruff.lineLength": 100,

  // api
  "fastapi-endpoint.files.include": "**/*.py",
  "fastapi-endpoint.files.exclude": "**/conda_env/**/*.*",

  // frontend
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnPaste": true,
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    }
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnPaste": true,
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    }
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnPaste": true,
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    }
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnPaste": true,
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    }
  },
  "prettier.configPath": "web/.prettierrc",
  "prettier.ignorePath": "web/.prettierignore",
  "tailwindCSS.experimental.configFile": "web/src/styles.css",
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "python.testing.pytestArgs": [
    "."
  ],
  "python.testing.unittestEnabled": false,
  "python.testing.pytestEnabled": true
}