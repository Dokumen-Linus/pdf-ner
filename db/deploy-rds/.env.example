# Copy these values into your shell or secret manager before running RDS deploy scripts.
# Do not commit real passwords.

RDS_HOST=dokumen-prod.cluster-REPLACE_ME.us-east-1.rds.amazonaws.com
RDS_PORT=5432
RDS_DB=dokumen
RDS_ADMIN_DB=postgres
RDS_ADMIN_USER=postgres
PGPASSWORD=REPLACE_ME_RDS_ADMIN_PASSWORD
PGSSLMODE=require

OWNER_ROLE_PASSWORD=REPLACE_ME_OWNER_ROLE_PASSWORD
AUTH_ROLE_PASSWORD=REPLACE_ME_AUTH_ROLE_PASSWORD
WEB_USER_PASSWORD=REPLACE_ME_WEB_USER_PASSWORD
API_USER_PASSWORD=REPLACE_ME_API_USER_PASSWORD
WORKERS_USER_PASSWORD=REPLACE_ME_WORKERS_USER_PASSWORD
