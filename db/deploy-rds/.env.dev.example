# Copy to db/deploy-rds/.env.dev and fill in local development values.

# Public development RDS endpoint settings.
DEV_RDS_ENDPOINT=<dev-rds-endpoint>
DEV_RDS_PORT=5432

# RDS admin connection values.
RDS_ADMIN_USER=postgres
PGPASSWORD=<dev-rds-master-password>
RDS_DB=dokumen
RDS_ADMIN_DB=postgres
PGSSLMODE=require

# Database role passwords created or updated by db/deploy-rds.
OWNER_ROLE_PASSWORD=<dev-owner-role-password>
AUTH_ROLE_PASSWORD=<dev-auth-role-password>
WEB_USER_PASSWORD=<dev-web-user-password>
API_USER_PASSWORD=<dev-api-user-password>
WORKERS_USER_PASSWORD=<dev-workers-user-password>
