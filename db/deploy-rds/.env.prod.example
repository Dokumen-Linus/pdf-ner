# Copy to db/deploy-rds/.env.prod and fill in local production values.

# SSH tunnel settings for the private production RDS instance.
PROD_RDS_ENDPOINT=<prod-rds-endpoint>
PROD_EC2_HOST=<ec2-public-ip-or-dns>
PROD_SSH_KEY=<absolute-path-to-ssh-private-key>
PROD_LOCAL_RDS_PORT=15432

# RDS admin connection values.
RDS_ADMIN_USER=postgres
PGPASSWORD=<prod-rds-master-password>
RDS_DB=dokumen
RDS_ADMIN_DB=postgres
PGSSLMODE=require

# Database role passwords created or updated by db/deploy-rds.
OWNER_ROLE_PASSWORD=<prod-owner-role-password>
AUTH_ROLE_PASSWORD=<prod-auth-role-password>
WEB_USER_PASSWORD=<prod-web-user-password>
API_USER_PASSWORD=<prod-api-user-password>
WORKERS_USER_PASSWORD=<prod-workers-user-password>
