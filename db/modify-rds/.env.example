# Copy to db/modify-rds/.env.development or db/modify-rds/.env.production.
# You can also keep using db/deploy-rds/.env.development or
# db/deploy-rds/.env.production.

RDS_HOST=*.*.us-east-1.rds.amazonaws.com
RDS_PORT=5432
RDS_DB=dokumen
RDS_ADMIN_USER=postgres
PGPASSWORD=*
PGSSLMODE=require

# Production scripts run psql/dbmate from the EC2 host through SSM by default
# so private production RDS DNS resolves inside the VPC.
AWS_REGION=us-east-1
PROJECT_NAME=dokumen
ENVIRONMENT=production
INSTANCE_NAME=dokumen-ec2
EC2_INSTANCE_ID=i-*
EC2_APP_DIR=/opt/dokumen/pdf-ner

# Explicit fallback only if SSM is unavailable.
USE_SSH_FALLBACK=0
SSH_PRIVATE_KEY_PATH=~/.ssh/dokumen-ec2
SSH_USER=ec2-user
