# Copy to db/modify-rds/.env.development or db/modify-rds/.env.production.
# You can also keep using db/deploy-rds/.env.development or
# db/deploy-rds/.env.production.

RDS_HOST=*.*.us-east-1.rds.amazonaws.com
RDS_PORT=5432
RDS_DB=dokumen
RDS_ADMIN_USER=postgres
PGPASSWORD=*
PGSSLMODE=require

# Production scripts open a local port forward through EC2 by SSM first, then
# run local psql/dbmate against 127.0.0.1:${PROD_LOCAL_RDS_PORT}.
AWS_REGION=us-east-1
PROJECT_NAME=dokumen
ENVIRONMENT=production
INSTANCE_NAME=dokumen-ec2
EC2_INSTANCE_ID=i-*
PROD_LOCAL_RDS_PORT=15432
PORT_FORWARD_READY_TIMEOUT_SECONDS=30

# Explicit fallback only if SSM is unavailable.
USE_SSH_FALLBACK=0
SSH_PRIVATE_KEY_PATH=~/.ssh/dokumen-ec2
SSH_USER=ec2-user
