{
  "mcpServers": {
    "tanstack": {
      "command": "npx",
      "args": ["@tanstack/cli", "mcp"]
    }
  },
  "permissions": {
    "allow": [
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "MultiEdit(*)",

      "Bash(*)",

      "WebFetch(domain:github.com)",
      "WebFetch(domain:bun.com)",
      "WebFetch(domain:tanstack.com)",
      "WebFetch(domain:docs.uploadthing.com)"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",

      "Bash(git push)",
      "Bash(git push:*)"
    ],
    "ask": []
  }
}