# Server-side env vars
# Leave SECRETS_STAGE empty for local .env loading. Set SECRETS_STAGE=prod on EC2.
SECRETS_STAGE=
AWS_REGION=us-east-1

BASE_URL=http://localhost:3000

DATABASE_URL=postgres://localhost:5432/dokumen?sslmode=disable
# need to replace ... with actual password here and in db\migrations\_init.sql
AUTH_DATABASE_URL=postgres://auth_role:...@localhost:5432/dokumen?sslmode=disable
WEB_DATABASE_URL=postgres://web_user:...@localhost:5432/dokumen?sslmode=disable

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

API_URL=http://localhost:8000
API_KEY=
HEALTHCHECK_TOKEN=

# Email (AWS SES) - FROM_EMAIL must be a verified identity in SES_AWS_REGION
SES_AWS_ACCESS_KEY_ID=
SES_AWS_SECRET_ACCESS_KEY=
SES_AWS_REGION=us-east-1
# Optional: override SES endpoint for local testing (e.g. LocalStack)
SES_AWS_ENDPOINT_URL=
FROM_EMAIL="no-reply@dokumenai.dev"
MY_EMAIL="zcharliebauer@gmail.com"

# PDF storage bucket creation (S3 compatible)
PDF_STORAGE_AWS_ACCESS_KEY_ID=
PDF_STORAGE_AWS_SECRET_ACCESS_KEY=
PDF_STORAGE_AWS_REGION=us-east-1
# Optional: override S3 endpoint for local testing (e.g. LocalStack)
PDF_STORAGE_AWS_ENDPOINT_URL=

STRIPE_SECRET_KEY=sk_test_...
# Client-side env vars
VITE_BASE_URL=http://localhost:3000
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

MICROSOFT_CLIENT_ID=...
MICROSOFT_CLIENT_SECRET=...
