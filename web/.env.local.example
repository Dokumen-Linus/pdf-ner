# Server-side env vars
NODE_ENV=development

BASE_URL=http://localhost:3000

DATABASE_URL=postgres://localhost:5432/dokumen?sslmode=disable
# need to replace ... with actual password here and in db\migrations\init.sql
APP_DATABASE_URL=postgres://app_user:...@localhost:5432/dokumen?sslmode=disable
AUTH_DATABASE_URL=postgres://auth_role:...@localhost:5432/dokumen?sslmode=disable

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Client-side env vars
VITE_BASE_URL=http://localhost:3000