# Server-side env vars
BASE_URL=http://localhost:3000

DATABASE_URL=postgres://localhost:5432/dokumen?sslmode=disable
# need to replace ... with actual password here and in db\migrations\_init.sql
AUTH_DATABASE_URL=postgres://auth_role:...@localhost:5432/dokumen?sslmode=disable
WEB_DATABASE_URL=postgres://web_user:...@localhost:5432/dokumen?sslmode=disable

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Email (AWS SES) — FROM_EMAIL must be a verified identity in SES for AWS_REGION
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Optional: override SES endpoint for local testing (e.g. LocalStack)
AWS_ENDPOINT_URL=
FROM_EMAIL="no-reply@dokumenai.dev"
MY_EMAIL="zcharliebauer@gmail.com"

UPLOADTHING_TOKEN=

STRIPE_SECRET_KEY=sk_test_...
# Client-side env vars
VITE_BASE_URL=http://localhost:3000
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...