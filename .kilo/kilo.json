{
  "$schema": "https://app.kilo.ai/config.json",

  "permission": {
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "lsp": "allow",
    "websearch": "allow",
    "codesearch": "allow",
    "webfetch": "allow",

    "external_directory": "deny",
    "doom_loop": "deny",

    "bash": {
      "ls": "allow",
      "ls *": "allow",

      "pwd": "allow",
      "pwd *": "allow",

      "cd": "allow",
      "cd *": "allow",

      "cat": "allow",
      "cat *": "allow",

      "head": "allow",
      "head *": "allow",

      "tail": "allow",
      "tail *": "allow",

      "grep": "allow",
      "grep *": "allow",

      "rg": "allow",
      "rg *": "allow",

      "find": "allow",
      "find *": "allow",

      "echo": "allow",
      "echo *": "allow",

      "sed": "allow",
      "sed *": "allow",

      "awk": "allow",
      "awk *": "allow",

      "wc": "allow",
      "wc *": "allow",

      "stat": "allow",
      "stat *": "allow",

      "pytest": "allow",
      "pytest *": "allow",

      "uv": "allow",
      "uv *": "allow",

      "uvx": "allow",
      "uvx *": "allow",

      "ruff": "allow",
      "ruff *": "allow",

      "npm run *": "allow",
      "npx *": "allow",
      "bun run *": "allow",

      "npm install": "allow",
      "npm install *": "allow",
      "bun install": "allow",
      "bun install *": "allow",

      "sudo": "deny",
      "sudo *": "deny",

      "pip": "deny",
      "pip *": "deny",

      "*": "ask"
    }
  }
}