{
  "$schema": "https://app.kilo.ai/config.json",
  "mcp": {
    "git": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-git",
        "--repository",
        "C:\\Users\\zchar\\Desktop\\pdf-ner\\"
      ],
      "enabled": true
    }
  },
  "permission": {
    "bash": {
      "pytest *": "allow",
      "echo *": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "find *": "allow",
      "pwd *": "allow",
      "cd *": "allow",
      "git *": "allow",
      "uv *": "allow",
      "ruff *": "allow",
      "npx *": "allow",
      "npm run *": "allow",
      "bun run *": "allow",
      "python *": "ask",
      "sudo *": "deny",
      "pip *": "deny",
      "*": "ask"
    },
    "edit": "allow"
  }
}
