# Worker service environment defaults
# Leave SECRETS_STAGE empty for local .env loading. Set SECRETS_STAGE=prod on EC2.
SECRETS_STAGE=
AWS_REGION=us-east-1

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
STRIPE_SECRET_KEY=

# Runpod OCR
OCR_MODEL=deepseek-ocr
DEEPSEEK_OCR_RUNPOD_ENDPOINT_URL=
OLM_OCR2_RUNPOD_ENDPOINT_URL=
RUNPOD_API_KEY=
OCR_RUNPOD_TIMEOUT_SECONDS=60
OCR_RUNPOD_RETRIES=0
