# existing EC2 target
AWS_REGION=us-east-1
PROJECT_NAME=dokumen
ENVIRONMENT=production
INSTANCE_NAME=dokumen-ec2
EC2_INSTANCE_ID=i-*

# migration target
EC2_APP_DIR=/opt/dokumen/pdf-ner
LOCAL_COMPOSE_FILE=infra/docker-compose.yml
ELASTICACHE_REPLICATION_GROUP_ID=dokumen-redis
ELASTICACHE_HEALTH_POLICY_NAME=dokumen-elasticache-health-read

# explicit fallback only
USE_SSH_FALLBACK=0
SSH_PRIVATE_KEY_PATH=~/.ssh/dokumen-ec2
SSH_USER=ec2-user
