APP_DIR=/opt/dokumen/pdf-ner
EC2_INSTANCE_ID=i-*
INSTANCE_NAME=dokumen-ec2
COMPOSE_FILE=infra/docker-compose.yml
ENV_FILE=infra/.env.prod
AWS_REGION=us-east-1

REQUIRED_SERVICES="api worker web"
OPTIONAL_SERVICES=
HOST_PORT_CHECKS="web:127.0.0.1:3000 api:127.0.0.1:8000"

CHECK_ELASTICACHE=1
ELASTICACHE_REPLICATION_GROUP_ID=dokumen-redis
CHECK_AWS_SECRETS=0
CHECK_SECRET_UNPACK=0
AWS_SECRET_NAMES="prod/web prod/email prod/api prod/workers prod/runpod"

CHECK_PUBLIC_TUNNEL=1
PUBLIC_HEALTH_BASE_URL=https://dokumenai.dev
CHECK_CLOUDFLARE_ORIGIN=0
REQUIRE_WEB_LOCAL_CHECK=0
WEB_LOCAL_URL=http://127.0.0.1:3000/api/healthz
LOG_LINES=120
