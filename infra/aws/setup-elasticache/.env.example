# existing resources
VPC_ID=vpc-*
PRIVATE_SUBNET_ID=subnet-*
PRIVATE_SUBNET_2_ID=subnet-*
SG_ID=sg-*

# ElastiCache config
AWS_REGION=us-east-1
ELASTICACHE_REPLICATION_GROUP_ID=dokumen-redis
ELASTICACHE_SUBNET_GROUP_NAME=dokumen-prod-elasticache-subnets
ELASTICACHE_SG_NAME=dokumen-prod-elasticache-sg
ELASTICACHE_ENGINE=redis
ELASTICACHE_ENGINE_VERSION=7.1
ELASTICACHE_NODE_TYPE=cache.t4g.micro
ELASTICACHE_PORT=6379
ELASTICACHE_AUTH_TOKEN=REPLACE_WITH_16_TO_128_ALLOWED_AUTH_CHARS
EXISTING_ELASTICACHE_AUTH_TOKEN_CONFIRMED=0
ELASTICACHE_SNAPSHOT_RETENTION_DAYS=2
ELASTICACHE_SNAPSHOT_WINDOW=07:00-08:00
ELASTICACHE_WAIT_POLL_SECONDS=30

# AWS tags
PROJECT_NAME=dokumen
ENVIRONMENT=production

# paths
SECRET_DRAFT_DIR=infra/aws/push-secrets/local-secrets
OUTPUT_DIR=infra/aws/outputs
