AWS_REGION=us-east-1
PROJECT_NAME=dokumen
ENVIRONMENT=development

# IAM customer managed policies used by the development SSO permission set.
DEV_WEB_API_POLICY_NAME=dokumen-dev-web-api
DEV_SECRETS_POLICY_NAME=dokumen-dev-local-secrets-read

# IAM Identity Center permission set, group, and target account.
DEV_SSO_PERMISSION_SET_NAME=dokudev-pem-set
DEV_SSO_GROUP_NAME=dokudev-group
DEV_SSO_TARGET_ACCOUNT_ID=
IAM_IDENTITY_CENTER_INSTANCE_ARN=arn:aws:sso:::instance/ssoins-*
IAM_IDENTITY_STORE_ID=

# User created by create-sso-user.sh.
FIRST_NAME=
LAST_NAME=
USER_EMAIL=
DEV_SSO_USER_NAME=
