# Required: Cloudflare remote-managed Tunnel token from infra/cloudflare/setup-tunnel/setup-tunnel.sh.
TUNNEL_TOKEN=REPLACE_WITH_CLOUDFLARE_TUNNEL_TOKEN

# Optional script defaults.
APP_DIR=/opt/dokumen/pdf-ner
REPO_URL=https://github.com/dokumenai/pdf-ner.git
DEPLOY_BRANCH=master
ENV_FILE=infra/.env.prod
AWS_REGION=us-east-1
REQUIRE_WEB_LOCAL_CHECK=0
WEB_LOCAL_URL=http://127.0.0.1:3000/api/healthz
CLOUDWATCH_LOG_GROUP_PREFIX=/dokumen/production/ec2
CLOUDWATCH_LOG_RETENTION_DAYS=14
CLOUDWATCH_AGENT_CONFIG_PATH=/opt/aws/amazon-cloudwatch-agent/etc/cloudwatch-agent.json
COMPOSE_FILE=infra/docker-compose.yml
STATE_DIR=/opt/dokumen/deploy-state
IMAGE_OVERRIDE_FILE=/opt/dokumen/deploy-state/docker-compose.images.yml
REQUIRED_SERVICES=api worker web
