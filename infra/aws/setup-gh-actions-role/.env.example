# existing resources
EC2_INSTANCE_ID=i-*

# AWS config
AWS_REGION=us-east-1
PROJECT_NAME=dokumen
ENVIRONMENT=production

# ECR repositories deployed by GitHub Actions
WEB_ECR_REPOSITORY=dokumen-web
API_ECR_REPOSITORY=dokumen-api
WORKERS_ECR_REPOSITORY=dokumen-workers

# GitHub Actions OIDC deploy role
GITHUB_REPO=dokumenai/pdf-ner
DEPLOY_BRANCH=master
GITHUB_ACTIONS_ROLE_NAME=dokumen-github-deploy
GITHUB_ACTIONS_POLICY_NAME=dokumen-github-deploy
GITHUB_OIDC_PROVIDER_NAME=dokumen-github-oidc-provider
GITHUB_OIDC_PROVIDER_URL=https://token.actions.githubusercontent.com
GITHUB_ACTIONS_POLICY_TEMPLATE=deploy-policy.json

# paths
OUTPUT_DIR=infra/aws/outputs
