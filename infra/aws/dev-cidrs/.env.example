# AWS config
AWS_REGION=us-east-1

# AWS tags and naming defaults
PROJECT_NAME=dokumen
ENVIRONMENT=development

# Current local development CIDR to allow, usually your public IP as /32.
DEV_CIDR=*.*.*.*/32

# Previous local development CIDR to remove when rotating.
PREVIOUS_DEV_CIDR=*.*.*.*/32

# Development Secrets Manager read policy scoped to allowed dev CIDRs.
DEV_SECRETS_POLICY_NAME=dokumen-dev-local-secrets-read
# Optional: set one of these to attach the policy automatically.
DEV_SECRETS_IAM_USER_NAME=
DEV_SECRETS_IAM_ROLE_NAME=

# Existing development RDS security group. Prefer explicit SG id when known.
DEV_RDS_SG_ID=sg-*
DEV_RDS_SG_NAME=dokumen-dev-rds-sg
DEV_VPC_ID=vpc-*
RDS_PORT=5432
