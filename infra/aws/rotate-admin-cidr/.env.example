# AWS config
AWS_REGION=us-east-1

# AWS tags and naming defaults
PROJECT_NAME=dokumen
ENVIRONMENT=production

# New admin network access to assign to every admin-only ingress rule.
ADMIN_CIDR=*.*.*.*/32

# Additional development database CIDR to allow without replacing existing rules.
DEV_DB_CIDR=*.*.*.*/32

# Existing EC2 security group. Prefer SG_ID when known.
SG_ID=sg-*
VPC_ID=vpc-*
SG_NAME=dokumen-ec2

# Existing RDS security groups. Prefer explicit SG ids when known.
RDS_SG_ID=sg-*
DEV_RDS_SG_ID=sg-*
PROD_RDS_SG_NAME=dokumen-prod-rds-sg
DEV_RDS_SG_NAME=dokumen-dev-rds-sg
DEV_VPC_ID=vpc-*
RDS_PORT=5432
