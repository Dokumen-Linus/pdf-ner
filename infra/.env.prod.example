# Production bootstrap env copied to EC2 as infra/.env.prod.
# App secrets live in AWS Secrets Manager, not in this file.

ENV=production
APP_VERSION=0.0.0
SECRETS_STAGE=prod
AWS_REGION=us-east-1

# Public browser config baked into the web image at build time.
VITE_BASE_URL=https://dokumenai.dev
VITE_STRIPE_PUBLISHABLE_KEY=REPLACE_WITH_STRIPE_PUBLISHABLE_KEY
