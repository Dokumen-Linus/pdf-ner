# PostgreSQL superuser (for initial setup - usually provided by your PostgreSQL service/docker-compose)
POSTGRES_PASSWORD=changeme

# Role passwords - must match what you set in db/init/01_roles.sh
OWNER_ROLE_PASSWORD=changeme
AUTH_ROLE_PASSWORD=changeme
WEB_USER_PASSWORD=changeme
API_USER_PASSWORD=changeme
WORKERS_USER_PASSWORD=changeme

# Redis
REDIS_URL=redis://localhost:6379/0

# Better Auth
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=https://yourdomain.com

# Email (AWS SES) — FROM_EMAIL must be a verified identity in SES for AWS_REGION
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Optional: override SES endpoint for local testing (e.g. LocalStack)
AWS_ENDPOINT_URL=
FROM_EMAIL=no-reply@yourdomain.com
MY_EMAIL=admin@yourdomain.com

# Stripe
STRIPE_SECRET_KEY=sk_live_...

# Workers (workers/.env.example)
WORKERS_DATABASE_URL=postgres://workers_user:changeme@localhost:5432/dokumen?sslmode=disable
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=

# API (api/.env.local.example)
API_DATABASE_URL=postgres://api_user:changeme@localhost:5432/dokumen?sslmode=disable
API_KEY=
CORS_ORIGINS=["http://localhost:3000"]
ALLOWED_HOSTS=["localhost", "127.0.0.1"]

# Avatars (S3 compatible)
AVATARS_BUCKET=
AVATARS_AWS_ACCESS_KEY_ID=
AVATARS_AWS_SECRET_ACCESS_KEY=
AVATARS_AWS_REGION=us-east-1
AVATARS_AWS_ENDPOINT_URL=

# Web (web/.env.local.example)
DATABASE_URL=postgres://localhost:5432/dokumen?sslmode=disable
AUTH_DATABASE_URL=postgres://auth_role:changeme@localhost:5432/dokumen?sslmode=disable
WEB_DATABASE_URL=postgres://web_user:changeme@localhost:5432/dokumen?sslmode=disable
BASE_URL=http://localhost:3000
UPLOADTHING_TOKEN=

# Client-side env vars (Vite)
VITE_BASE_URL=http://localhost:3000
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
