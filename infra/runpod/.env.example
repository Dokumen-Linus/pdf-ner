# Local operator inputs for infra/runpod/runpod-deploy-pods.sh.
# Copy to infra/runpod/.env.local on your Linux deployment machine.
# Do not commit infra/runpod/.env.local.

PROJECT_NAME=dokumen
AWS_REGION=us-east-1

# Required. Use an explicit immutable tag; do not use latest.
IMAGE_TAG=v0.1.0

# Required for Runpod REST API, registry auth sync, and Pod smoke tests.
RUNPOD_API_KEY=REPLACE_ME

# Required. This protects public Runpod Pod proxy POST /ocr requests.
# Put the same value in prod/runpod as OCR_RUNPOD_HTTP_TOKEN.
OCR_HTTP_BEARER_TOKEN=REPLACE_ME

# Optional for gated/private Hugging Face models.
HF_TOKEN=

# ECR repository names. Defaults are derived from PROJECT_NAME.
DEEPSEEK_ECR_REPOSITORY=dokumen-deepseek-ocr
OLM_OCR2_ECR_REPOSITORY=dokumen-olm-ocr2

# Fixed Runpod Pod IDs. Leave blank only for the first bootstrap run with
# CREATE_PODS=1, then save the printed Pod IDs here and in GitHub Actions vars.
DEEPSEEK_RUNPOD_POD_ID=
OLM_OCR2_RUNPOD_POD_ID=
CREATE_PODS=0

# Runpod Pod sizing. These workers must not use network volumes.
RUNPOD_GPU_TYPE="NVIDIA GeForce RTX 5090"
RUNPOD_GPU_COUNT=1
RUNPOD_CLOUD_TYPE=SECURE
RUNPOD_DATA_CENTER_IDS=
CONTAINER_DISK_GB=80
VOLUME_GB=120
VOLUME_MOUNT_PATH=/workspace

# Worker HTTP settings.
PORT=8000
PORT_HEALTH=8000

# Model settings.
DEEPSEEK_MODEL_NAME=deepseek-ai/DeepSeek-OCR
DEEPSEEK_OCR_PROMPT="<image>\nFree OCR."
DEEPSEEK_MAX_TOKENS=2048
DEEPSEEK_TEMPERATURE=0.0
DEEPSEEK_NGRAM_SIZE=30
DEEPSEEK_NGRAM_WINDOW_SIZE=90

OLM_OCR2_MODEL_NAME=allenai/olmOCR-2-7B-1025-FP8
OLM_OCR2_PROCESSOR_NAME=Qwen/Qwen2.5-VL-7B-Instruct
OLM_OCR2_MAX_NEW_TOKENS=8000
OLM_OCR2_TEMPERATURE=0.1
OLM_OCR2_TARGET_LONGEST_IMAGE_DIM=1288
OLM_OCR2_GPU_MEMORY_UTILIZATION=0.9
OLM_OCR2_MAX_MODEL_LEN=
