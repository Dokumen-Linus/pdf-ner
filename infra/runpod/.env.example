# Local operator inputs for infra/runpod/runpod-setup.sh.
# Copy to infra/runpod/.env.local on your Linux deployment machine.
# Do not commit infra/runpod/.env.local.

PROJECT_NAME=dokumen

# Required. Use an explicit immutable tag; do not use latest.
DOCKERHUB_NAMESPACE=REPLACE_ME
IMAGE_TAG=v0.1.0

# Required by Runpod REST API and endpoint smoke tests.
RUNPOD_API_KEY=REPLACE_ME

# Runpod GPU and CUDA settings. RTX 5090 is a Blackwell-class GPU, so keep CUDA
# at 12.8 or newer for vLLM/PyTorch compatibility.
RUNPOD_GPU_TYPE="NVIDIA GeForce RTX 5090"
RUNPOD_GPU_COUNT=1
RUNPOD_MIN_CUDA_VERSION=12.8
RUNPOD_ALLOWED_CUDA_VERSIONS=12.8,12.9,13.0
RUNPOD_DATA_CENTER_IDS=

# Serverless worker sizing.
WORKERS_MIN=0
WORKERS_MAX=1
IDLE_TIMEOUT=30
SCALER_TYPE=QUEUE_DELAY
SCALER_VALUE=4
EXECUTION_TIMEOUT_MS=330000
CONTAINER_DISK_GB=80

# Optional private Docker registry auth created in Runpod.
# Leave blank for public Docker Hub images.
RUNPOD_CONTAINER_REGISTRY_AUTH_ID=

# Image names. Defaults are derived from DOCKERHUB_NAMESPACE and IMAGE_TAG.
DEEPSEEK_IMAGE=
OLM_OCR2_IMAGE=

# Worker HTTP settings.
PORT=8000
PORT_HEALTH=8000

# Hugging Face token is optional for public models, required for gated/private
# model repos.
HF_TOKEN=

# DeepSeek OCR model settings.
DEEPSEEK_MODEL_NAME=deepseek-ai/DeepSeek-OCR
DEEPSEEK_OCR_PROMPT="<image>\nFree OCR."
DEEPSEEK_MAX_TOKENS=2048
DEEPSEEK_TEMPERATURE=0.0
DEEPSEEK_NGRAM_SIZE=30
DEEPSEEK_NGRAM_WINDOW_SIZE=90

# olmOCR2 model settings.
OLM_OCR2_MODEL_NAME=allenai/olmOCR-2-7B-1025-FP8
OLM_OCR2_PROCESSOR_NAME=Qwen/Qwen2.5-VL-7B-Instruct
OLM_OCR2_MAX_NEW_TOKENS=8000
OLM_OCR2_TEMPERATURE=0.1
OLM_OCR2_TARGET_LONGEST_IMAGE_DIM=1288
OLM_OCR2_GPU_MEMORY_UTILIZATION=0.9
OLM_OCR2_MAX_MODEL_LEN=

# Set to 0 to build/push templates only, then create load-balancing endpoints in
# the Runpod console from the generated templates.
RUNPOD_CREATE_ENDPOINTS=1

# Set to 1 to create fresh templates/endpoints instead of updating IDs recorded
# in infra/runpod/local-state/runpod-state.json.
FORCE_RECREATE=0
