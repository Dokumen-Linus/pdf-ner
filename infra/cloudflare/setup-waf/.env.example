# Required: Cloudflare API token with Zone WAF Write permission for this zone.
CLOUDFLARE_API_TOKEN=REPLACE_WITH_CLOUDFLARE_API_TOKEN
CLOUDFLARE_ACCOUNT_ID=REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID
CLOUDFLARE_ZONE_ID=REPLACE_WITH_CLOUDFLARE_ZONE_ID

# Optional script defaults.
PUBLIC_HOSTNAMES="dokumenai.dev www.dokumenai.dev"
WAF_MODE=monitor
CF_API_BASE=https://api.cloudflare.com/client/v4
DRY_RUN=0

# Plan-specific overrides (optional).
# Free: overrides CLOUDFLARE_FREE_RULESET_ID
# Pro:  overrides CLOUDFLARE_MANAGED_RULESET_ID, CLOUDFLARE_OWASP_RULESET_ID, CLOUDFLARE_EXPOSED_CREDENTIALS_RULESET_ID
