# Required: Cloudflare API token with Tunnel edit and DNS edit permissions.
CLOUDFLARE_API_TOKEN=REPLACE_WITH_CLOUDFLARE_API_TOKEN
CLOUDFLARE_ACCOUNT_ID=REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID
CLOUDFLARE_ZONE_ID=REPLACE_WITH_CLOUDFLARE_ZONE_ID

# Optional script defaults.
TUNNEL_NAME=dokumen-prod
PUBLIC_HOSTNAMES="dokumenai.dev www.dokumenai.dev"
TUNNEL_SERVICE_URL=http://localhost:3000
