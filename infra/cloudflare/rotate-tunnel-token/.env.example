# Cloudflare access
CLOUDFLARE_API_TOKEN=REPLACE_WITH_CLOUDFLARE_API_TOKEN
CLOUDFLARE_ACCOUNT_ID=REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID
CLOUDFLARE_ZONE_ID=REPLACE_WITH_CLOUDFLARE_ZONE_ID

# Use the TUNNEL_ID printed by setup-tunnel, or omit it and set TUNNEL_NAME
TUNNEL_ID=REPLACE_WITH_CLOUDFLARE_TUNNEL_ID
TUNNEL_NAME=dokumen-prod

# Optional defaults
CF_API_BASE=https://api.cloudflare.com/client/v4
