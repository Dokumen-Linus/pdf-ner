# Local operator inputs for infra/init/aws-setup.sh.
# Copy to infra/init/.env.local on your workstation. Do not commit infra/init/.env.local.

# Required GitHub/branch values used for EC2 git checkout and GitHub OIDC trust.
GITHUB_REPO=dokumenai/pdf-ner
DEPLOY_BRANCH=master
# Optional private GitHub repo deploy key. Add the matching public key to GitHub
# as a read-only deploy key, then set this to the local private key path.
GITHUB_DEPLOY_KEY_PATH=

# AWS/account target. AWS credentials still come from your AWS CLI profile or SSO session.
AWS_REGION=us-east-1
PROJECT_NAME=dokumen
DOMAIN=dokumenai.dev
REPO_URL=https://github.com/dokumenai/pdf-ner.git

# EC2 and SSH inputs.
INSTANCE_TYPE=t3.large
KEY_NAME=dokumen-ec2
SSH_PUBKEY_PATH=~/.ssh/dokumen-ec2.pub
SSH_PRIVATE_KEY_PATH=~/.ssh/dokumen-ec2
REMOTE_APP_DIR=/opt/dokumen/pdf-ner

# Setup/deploy toggles.
DO_DEPLOY=1
UPLOAD_LOCAL_ENV=1
START_COMPOSE=1
COMPOSE_SERVICES=
DEPLOY_CLEAN_CHECKOUT=1
DEPLOY_PRUNE_DOCKER=1
CREATE_PROD_RDS=1
CREATE_DEV_RDS=1
REFRESH_RDS_ADMIN_IP=1
SSH_CONNECT_TIMEOUT=10
SSH_WAIT_ATTEMPTS=30
SSH_WAIT_SECONDS=30

# Optional resumable/decomposed setup controls.
# SETUP_RESUME=1 starts at the first step not marked complete in local state.
# SETUP_START_AT and SETUP_STOP_AFTER accept these step ids:
# prerequisites, networking, ec2-instance, avatar-bucket, ecr-runtime-iam,
# github-deploy-iam, prod-rds, dev-rds, rds-admin-ingress, secrets-ses,
# ec2-deployment, summary.
SETUP_RESUME=0
SETUP_START_AT=
SETUP_STOP_AFTER=
SETUP_ONLY=

# Optional local state output for resumable runs. This path is gitignored.
# Default: infra/init/local-state.
# SETUP_STATE_DIR=
# SETUP_STATE_FILE=
# SETUP_REPORT_FILE=

# Optional production bootstrap env file to upload to EC2.
# Default: infra/.env.prod.
# PROD_ENV_FILE=

# Optional local draft output for reviewed AWS Secrets Manager JSON files.
# Default: infra/init/local-secrets. This path is gitignored.
# SECRET_DRAFT_DIR=

# Optional SES identity verification target.
SES_IDENTITY_EMAIL=no-reply@dokumenai.dev

# Optional network CIDRs.
VPC_CIDR=10.40.0.0/16
PUBLIC_SUBNET_CIDR=10.40.1.0/24
PUBLIC_SUBNET_2_CIDR=10.40.2.0/24

# Optional production RDS settings. Keep real passwords only in your local shell
# or infra/init/.env.local; never commit them.
PROD_RDS_IDENTIFIER=dokuprod
PROD_RDS_MASTER_PASSWORD=REPLACE_ME_PROD_RDS_MASTER_PASSWORD
PROD_RDS_ALLOW_LOCAL_ADMIN=1

# Optional development RDS settings. dokudev is created in a separate public VPC
# and is restricted to your current public /32 by authorize-rds-admin-ip.sh.
DEV_PROJECT_NAME=dokumen-dev
DEV_VPC_CIDR=10.50.0.0/16
DEV_PUBLIC_SUBNET_1_CIDR=10.50.1.0/24
DEV_PUBLIC_SUBNET_2_CIDR=10.50.2.0/24
DEV_RDS_IDENTIFIER=dokudev
DEV_RDS_MASTER_PASSWORD=REPLACE_ME_DEV_RDS_MASTER_PASSWORD

# Shared RDS defaults used by aws-setup.sh production and development RDS steps.
RDS_ENGINE=postgres
RDS_ENGINE_VERSION=18
RDS_INSTANCE_CLASS=db.t4g.micro
RDS_ALLOCATED_STORAGE=20
RDS_STORAGE_TYPE=gp3
RDS_DB_NAME=dokumen
RDS_MASTER_USERNAME=postgres
RDS_BACKUP_RETENTION_DAYS=7
RDS_DELETION_PROTECTION=1
RDS_PORT=5432

# Optional app role passwords. If these are set while running aws-setup.sh,
# the local Secrets Manager draft JSON files are patched with production DB URLs.
OWNER_ROLE_PASSWORD=REPLACE_ME_OWNER_ROLE_PASSWORD
AUTH_ROLE_PASSWORD=REPLACE_ME_AUTH_ROLE_PASSWORD
WEB_USER_PASSWORD=REPLACE_ME_WEB_USER_PASSWORD
API_USER_PASSWORD=REPLACE_ME_API_USER_PASSWORD
WORKERS_USER_PASSWORD=REPLACE_ME_WORKERS_USER_PASSWORD

# Optional generated resource names.
WEB_ECR_REPOSITORY=dokumen-web
API_ECR_REPOSITORY=dokumen-api
WORKERS_ECR_REPOSITORY=dokumen-workers
GPU_DEEPSEEK_ECR_REPOSITORY=dokumen-deepseek-ocr
GPU_OLM_OCR2_ECR_REPOSITORY=dokumen-olm-ocr2

# Optional avatar bucket override. Leave blank to let aws-setup.sh generate one.
AVATARS_S3_BUCKET_NAME=web-avatars
