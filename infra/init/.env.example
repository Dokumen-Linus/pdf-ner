# Local operator inputs for infra/init/aws-setup.sh.
# Copy to infra/init/.env.local on your workstation. Do not commit infra/init/.env.local.

# Required GitHub/branch values used for EC2 git checkout and GitHub OIDC trust.
GITHUB_REPO=dokumenai/pdf-ner
DEPLOY_BRANCH=master

# AWS/account target. AWS credentials still come from your AWS CLI profile or SSO session.
AWS_REGION=us-east-1
PROJECT_NAME=dokumen
DOMAIN=dokumenai.dev
REPO_URL=https://github.com/dokumenai/pdf-ner.git

# EC2 and SSH inputs.
INSTANCE_TYPE=t3.medium
KEY_NAME=dokumen-ec2
SSH_PUBKEY_PATH=~/.ssh/dokumen-ec2.pub
SSH_PRIVATE_KEY_PATH=~/.ssh/dokumen-ec2
REMOTE_APP_DIR=/opt/dokumen/pdf-ner

# Setup/deploy toggles.
DO_DEPLOY=1
UPLOAD_LOCAL_ENV=1
START_COMPOSE=1

# Optional production bootstrap env file to upload to EC2.
# Default: infra/.env.prod.
# PROD_ENV_FILE=

# Optional local draft output for reviewed AWS Secrets Manager JSON files.
# Default: infra/init/local-secrets. This path is gitignored.
# SECRET_DRAFT_DIR=

# Optional SES identity verification target.
SES_IDENTITY_EMAIL=no-reply@dokumenai.dev

# Optional network CIDRs.
VPC_CIDR=10.40.0.0/16
PUBLIC_SUBNET_CIDR=10.40.1.0/24

# Optional generated resource names.
WEB_ECR_REPOSITORY=dokumen-web
API_ECR_REPOSITORY=dokumen-api
WORKERS_ECR_REPOSITORY=dokumen-workers

# Optional avatar bucket override. Leave blank to let aws-setup.sh generate one.
AVATARS_S3_BUCKET_NAME=

# Optional GitHub OIDC thumbprint override. Usually leave this blank.
GITHUB_OIDC_THUMBPRINT=
